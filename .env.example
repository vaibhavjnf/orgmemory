# OrgMemory — local demo (Weave was an internal codename)
# `pnpm dev` works with zero env. Do not commit real secrets.

ORGMEMORY_API_PORT=43121
ORGMEMORY_API_HOST=127.0.0.1
ORGMEMORY_SQLITE_PATH=./data/orgmemory.sqlite
ORGMEMORY_EMBEDDING_PROVIDER=local-hash
# OPENAI_API_KEY=
ORGMEMORY_RANK_WEIGHTS=sim:0.34,recency:0.14,reuse:0.18,authority:0.12,project:0.12,acl:0.10

# cloud = all features on without a token. onprem/oem require ORGMEMORY_LICENSE_TOKEN.
ORGMEMORY_LICENSE_MODE=cloud
# ORGMEMORY_LICENSE_TOKEN=
ORGMEMORY_LICENSE_SECRET=orgmemory-demo-license-secret
ORGMEMORY_BLOCK_EMPLOYEES_AFTER_HOURS=false

ORGMEMORY_LICENSE_PORT=43123
VITE_DEV_PORT=43122

# Hosted Hermes worker (pnpm worker). 0 = one tick then exit.
ORGMEMORY_API_URL=http://127.0.0.1:43121
ORGMEMORY_WORKER_POLL_MS=0
